# World Intel server configuration.
# All keys are OPTIONAL — the terminal runs on keyless sources without them.
# Copy to server/.env and fill in what you have.

# FRED (free): unlocks the macro dashboard (CPI, PCE, payrolls, Fed balance
# sheet, HY/IG spreads, TGA, RRP, financial conditions...)
# Get a key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub (free tier): reserved for company-level data expansion
FINNHUB_API_KEY=

# LLM narration for briefs & event analysis (either one; Anthropic preferred)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Server port (default 8787)
# PORT=8787
